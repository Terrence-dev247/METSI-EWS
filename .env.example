# METSI-EWS  —  SMTP credentials template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your credentials
# 3. Add .env to .gitignore  (NEVER commit credentials)
#
# Gmail setup:
#   a) Enable 2-Step Verification on your Google account
#   b) Go to: https://myaccount.google.com/apppasswords
#   c) Generate an App Password for "Mail" → paste below as METSI_SMTP_PASS
#
# Optional: pip install python-dotenv
# Then add to the top of your Streamlit app:
#   from dotenv import load_dotenv; load_dotenv()
# ─────────────────────────────────────────────────────────────────────────────

METSI_SMTP_HOST=smtp.gmail.com
METSI_SMTP_PORT=587
METSI_SMTP_USER=your.email@gmail.com
METSI_SMTP_PASS=xxxx xxxx xxxx xxxx
